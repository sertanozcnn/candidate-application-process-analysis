CAPA_APP_ENV=development
CAPA_LOG_LEVEL=info
# CAPA ortam değişkenleri.
# Bu dosyada yalnızca açıkça yerel ve sahte örnek değerler bulunabilir.
# Gerçek değerleri `.env` dosyasında tut; `.env` Git tarafından dışlanır.

CAPA_API_ADDR=:8080
CAPA_API_SHUTDOWN_TIMEOUT=10s
CAPA_API_URL=http://localhost:8080

CAPA_POSTGRES_HOST=localhost
CAPA_POSTGRES_HOST_PORT=55432
CAPA_POSTGRES_DB=capa
CAPA_POSTGRES_USER=capa
CAPA_POSTGRES_PASSWORD=capa_local_password
CAPA_DATABASE_URL=postgres://capa:capa_local_password@localhost:55432/capa?sslmode=disable

